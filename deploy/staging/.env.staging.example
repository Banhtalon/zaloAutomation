# Copy to a secret-managed environment file; do not commit the copy.
# Phase 9B staging is read-only with respect to Zalo/BCNB/Google Form.
APP_VERSION=4.0.0-staging
GOOGLE_FORM_MODE=dry-run
BCNB_DRY_RUN=true
BCNB_URL=https://teachingmindx.top/check_nhanxet.php

# Web auth is mandatory behind the TLS proxy.
AUTH_MODE=web
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=zalo_session
AUTH_SECURE_COOKIE=true
AUTH_ALLOWED_HOSTS=staging.example.com
AUTH_ALLOWED_ORIGINS=https://staging.example.com
AUTH_USERS_JSON=[{"username":"admin","role":"Admin","password_hash":"<pbkdf2_sha256 hash generated offline>"}]

# Keep state on the staging host. The current session/profile design is single-replica.
DATABASE_PATH=/srv/zaloAutomation/database.db
UPLOAD_ROOT=/srv/zaloAutomation/runtime/uploads
RUNTIME_ROOT=/srv/zaloAutomation/runtime
LOG_DIR=/srv/zaloAutomation/runtime/logs
EVIDENCE_ROOT=/srv/zaloAutomation/runtime/evidence
BROWSER_PROFILE_PATH=/srv/zaloAutomation/zalo_session
LOCK_ROOT=/srv/zaloAutomation/runtime/locks
DB_BACKUP_ROOT=/srv/zaloAutomation/.backups/db
DB_BACKUP_RETENTION_COUNT=7
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=8
