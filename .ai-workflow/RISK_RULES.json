{
  "schema_version": "qq.workflow.risk-rules.v9",
  "default_risk": "GREEN",
  "level_controls": {
    "GREEN": { "required_roles": [] },
    "YELLOW": { "required_roles": ["QUALIFIED_REVIEWER"] },
    "RED": { "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"] }
  },
  "rules": [
    {
      "id": "workflow-control-plane",
      "risk": "YELLOW",
      "path_globs": [
        ".ai-workflow/**",
        ".agents/**",
        ".github/ISSUE_TEMPLATE/**",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "AGENTS.md",
        "GEMINI.md",
        "AGENT_WORKFLOW.md",
        ".codex/**",
        ".gitattributes",
        ".gitignore",
        "package.json",
        "README.md",
        "VERSION",
        "VERSION.md",
        "scripts/**",
        "scripts/freeze-manifest.mjs",
        "scripts/inspect-risk.mjs",
        "scripts/install.mjs",
        "scripts/owner-status.mjs",
        "scripts/prepare-attempt.mjs",
        "scripts/run-pilots.mjs",
        "scripts/run-redacted.mjs",
        "scripts/verify-task.mjs",
        "scripts/lib/**",
        "test/**",
        "tests/**",
        "docs/*WORKFLOW*",
        "docs/*STATE*",
        "docs/*GUIDE*",
        "docs/workflow/**"
      ],
      "required_roles": ["QUALIFIED_REVIEWER"],
      "reason": "Workflow policy, evidence, or deterministic gate control changed"
    },
    {
      "id": "application-runtime",
      "risk": "YELLOW",
      "path_globs": [
        "src/**",
        "apps/**",
        "lib/**",
        "api/**",
        "core/**",
        "services/**",
        "repositories/**",
        "models/**",
        "classifiers/**",
        "googleform_autosubmit/**",
        "main.py"
      ],
      "required_roles": ["QUALIFIED_REVIEWER"],
      "reason": "Runtime behavior or application integration changed"
    },
    {
      "id": "ci-control",
      "risk": "YELLOW",
      "path_globs": [
        ".github/workflows/**",
        "CHECK_QUALITY.ps1",
        "QUALITY.bat",
        "pyproject.toml",
        "requirements.txt",
        "requirements-dev.txt",
        "requirements.lock.txt"
      ],
      "required_roles": ["QUALIFIED_REVIEWER"],
      "reason": "CI, quality, or dependency execution control changed"
    },
    {
      "id": "authentication-or-permission",
      "risk": "RED",
      "path_globs": [
        "**/auth/**",
        "**/permissions/**",
        "**/middleware.*",
        "**/*auth*",
        "**/*login*",
        "**/*permission*",
        "**/*credential*",
        "**/*session*",
        "**/*profile*",
        "core/auth.py"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Authentication, authorization, credential, or session boundary changed"
    },
    {
      "id": "secret-material",
      "risk": "RED",
      "path_globs": [
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*",
        "**/*secret*",
        "**/*token*",
        "**/*credential*",
        "**/*private-key*",
        "zalo_session/**"
      ],
      "diff_patterns": [
        "(?:GEMINI_API_KEY|BCNB_PASSWORD|BCNB_USERNAME|API_TOKEN)\\s*=",
        "Bearer\\s+[A-Za-z0-9._~+/-]+"
      ],
      "required_roles": ["TECHNICAL_OPERATOR"],
      "reason": "Secret-bearing path or material detected"
    },
    {
      "id": "database-or-migration",
      "risk": "RED",
      "path_globs": [
        "db/**",
        "repositories/**",
        "**/migrations/**",
        "**/*migration*",
        "**/*schema*",
        "database.db*",
        "**/*.sqlite",
        "**/*.sqlite3"
      ],
      "diff_patterns": [
        "\\b(?:DROP|ALTER|CREATE)\\s+(TABLE|SCHEMA|DATABASE)\\b",
        "\\bTRUNCATE\\b"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Schema, migration, or persisted data behavior may change"
    },
    {
      "id": "deployment-control",
      "risk": "RED",
      "path_globs": [
        "deploy/**",
        "infra/**",
        "Dockerfile",
        "docker-compose*.yml",
        "Procfile"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Deployment or infrastructure control changed"
    },
    {
      "id": "external-service-boundary",
      "risk": "RED",
      "path_globs": [
        "api/zalo_routes.py",
        "api/googleform_routes.py",
        "api/lms_routes.py",
        "services/external_gateways.py",
        "services/zalo*.py",
        "services/googleform*.py",
        "services/lms*.py",
        "googleform_autosubmit/**",
        "**/*playwright*",
        "**/*gemini*",
        "**/*external*"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "External browser, AI provider, Zalo, BCNB, or form service boundary changed"
    },
    {
      "id": "user-data-and-privacy",
      "risk": "RED",
      "path_globs": [
        "**/*student*",
        "**/*user-data*",
        "**/*pii*",
        "**/uploads/**",
        "static/screenshots/**",
        "evidence/live/**"
      ],
      "diff_patterns": [
        "\\b(?:student_name|class_code|phone|email|cookie|storage_state)\\b"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "User, student, privacy, or authenticated-state data may be exposed"
    },
    {
      "id": "destructive-or-production-write",
      "risk": "RED",
      "diff_patterns": [
        "\\bDROP\\s+(TABLE|SCHEMA|DATABASE)\\b",
        "\\bTRUNCATE\\b",
        "\\bDELETE\\s+FROM\\b",
        "service[_-]?role",
        "force[_-]?push",
        "production[_-]?write",
        "rm\\s+-rf",
        "BCNB_DRY_RUN\\s*=\\s*false",
        "GOOGLE_FORM_MODE\\s*=\\s*production"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Destructive, privileged, or production write operation detected"
    }
  ]
}
