GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Secondary AI assist for ambiguous Zalo messages (review-only; never auto-ticks BCNB)
ZALO_AI_ASSIST_CLASSIFIER=false

BCNB_USERNAME=your_bcnb_username
BCNB_PASSWORD=your_bcnb_password
BCNB_URL=https://teachingmindx.top/check_nhanxet.php
# Safe default. Change to false only after reviewing a dry-run plan.
BCNB_DRY_RUN=true

LMS_USERNAME=your_lms_username
LMS_PASSWORD=your_lms_password
LMS_URL=https://lms.mindx.edu.vn/admin/class-sessions?centres=[%22644346f794300678908f79bc%22]&type=[%22MISS_ATTEND%22,%22DUE_COMMENT%22]&haveSlot=[]&status=[%22FINISHED%22,%22RUNNING%22]&pageIndex=0&itemsPerPage=20&orderBy=%22createdAt_desc%22

FORM_URL=your_google_form_url
GOOGLE_FORM_MODE=dry-run
GOOGLEFORM_IDEMPOTENCY_TTL_HOURS=24
GOOGLE_FORM_CONCURRENCY_LIMIT=3
GOOGLE_FORM_RATE_LIMIT=5
GOOGLE_FORM_HEADLESS=false
MAX_UPLOAD_BYTES=8388608
MAX_HTTP_BODY_BYTES=12582912
MAX_IMAGE_PIXELS=24000000
UPLOAD_ROOT=runtime/uploads
UPLOAD_RETENTION_HOURS=24
JOB_HEARTBEAT_SECONDS=5
RUNTIME_ROOT=runtime
BROWSER_PROFILE_PATH=zalo_session
LOCK_ROOT=runtime/locks
EVIDENCE_ROOT=static/screenshots
EVIDENCE_RETENTION_DAYS=7
EVIDENCE_RETENTION_POLICY=tombstone
# Keep audit/metadata rows, but delete expired PNG bytes on the next run.
EVIDENCE_DELETE_EXPIRED=true
DB_BACKUP_ROOT=.backups/db
DB_BACKUP_RETENTION_COUNT=7
CLASS_ENDED_ARCHIVE_DAYS=7
BCNB_CLASS_STATUS_URL=https://teachingmindx.top/hocsinh.php?datatable=students
MAX_CONCURRENT_JOBS=1
ZALO_SCAN_CONCURRENCY=2
BCNB_WRITE_CONCURRENCY=2
ZALO_PLAN_MAX_AGE_MINUTES=30
BATCH_SYSTEMIC_FAILURE_LIMIT=3
BATCH_ABNORMAL_PERCENT_LIMIT=20
MAX_QUEUED_JOBS=8
JOB_TIMEOUT_SECONDS=1800
LEASE_TIMEOUT_SECONDS=90
SHUTDOWN_GRACE_SECONDS=20
QUEUE_POLL_SECONDS=0.25
GATEWAY_MAX_RETRIES=2
GATEWAY_BACKOFF_SECONDS=0.25
GATEWAY_FAILURE_THRESHOLD=3
GATEWAY_COOLDOWN_SECONDS=30
LMS_CONFIRMATION_TTL_MINUTES=30

# Giai đoạn 3: logging/health/metrics cục bộ
APP_VERSION=4.0.0
LOG_LEVEL=INFO
LOG_DIR=runtime/logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_MEMORY_LINES=500
METRICS_WINDOW_HOURS=24
HEALTH_STALE_SECONDS=30
MIN_FREE_DISK_BYTES=104857600

# Gửi báo cáo CSV lớp lỗi về email Quản lý
# Mặc định giai đoạn thử nghiệm gửi về email Owner: quangda@mindx.net.vn
# Khi chạy chính thức cho cả 2 quản lý: REPORT_EMAIL_RECIPIENTS=quangda@mindx.net.vn,tuanpa@mindx.com.vn
REPORT_EMAIL_RECIPIENTS=quangda@mindx.net.vn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Web deployment safety. Local development intentionally stays passwordless
# and loopback-only; production must override every value below explicitly.
AUTH_MODE=local
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=zalo_session
AUTH_SECURE_COOKIE=false
AUTH_ALLOWED_HOSTS=127.0.0.1,localhost,::1,testserver,testclient
AUTH_ALLOWED_ORIGINS=
# Personal local-only production escape hatch. Leave empty by default.
# The current /run-scan endpoint is broad; set this exact value only when
# you explicitly accept external writes to all eligible rows in the batch:
# LOCAL_PRODUCTION_ACK=I_UNDERSTAND_LOCAL_BROAD_WRITES
# Production requirements (do not copy secrets into this file):
# AUTH_MODE=web
# AUTH_SECURE_COOKIE=true
# AUTH_USERS_JSON=[{"username":"admin","role":"Admin","password_hash":"<pbkdf2_sha256 hash>"}]
# AUTH_ALLOWED_HOSTS=automation.example.com
# AUTH_ALLOWED_ORIGINS=https://automation.example.com
